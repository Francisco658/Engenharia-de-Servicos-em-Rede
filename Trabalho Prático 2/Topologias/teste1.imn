node n1 {
    type router
    model PC
    network-config {
	hostname n1
	!
	interface eth0
	 ip address 10.0.0.20/24
	 ipv6 address 2001:0::20/64
	!
    }
    canvas c1
    iconcoords {62.666666666666664 88.33333333333333}
    labelcoords {57.333333333333336 147.0}
    interface-peer {eth0 n3}
}

